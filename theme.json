{
  "name": "Health System Performance",
  "dataColors": [
    "#1F4E9A",
    "#7FA7D9",
    "#0B2E59",
    "#3D85C6",
    "#B7D0EC",
    "#5B7DB1",
    "#2B6CB0",
    "#C5D3E3"
  ],
  "background": "#FCFCFB",
  "foreground": "#0B0B0B",
  "tableAccent": "#1F4E9A",
  "good": "#0CA30C",
  "neutral": "#FAB219",
  "bad": "#D03B3B",
  "maximum": "#0B2E59",
  "center": "#5B8FD0",
  "minimum": "#E3EDF8",
  "textClasses": {
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B0B0B"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#52514E"
    },
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B2E59"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B0B0B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#0B0B0B"
              }
            },
            "alignment": "left"
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#52514E"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E6E4DF"
              }
            },
            "gridlineStyle": "solid",
            "labelColor": {
              "solid": {
                "color": "#52514E"
              }
            }
          }
        ],
        "legend": [
          {
            "position": "Top",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#52514E"
              }
            }
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0B0B0B"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FCFCFB"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F9"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 28,
            "color": {
              "solid": {
                "color": "#0B2E59"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#52514E"
              }
            }
          }
        ]
      }
    }
